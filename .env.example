# 0.0.0.0 открывает приложение по IP Linux-сервера.
# Укажите 127.0.0.1, если доступ будет только через локальный reverse proxy.
APP_BIND_HOST=0.0.0.0
APP_PORT=43817
APP_TIMEZONE=Europe/Moscow
WB_REQUEST_INTERVAL_SECONDS=20.2
WB_HTTP_TIMEOUT_SECONDS=30
DATA_DIR=/data
# После настройки HTTPS через reverse proxy переключите на true.
SESSION_HTTPS_ONLY=false
